export ZDOTDIR=~/.config/zsh
# Set Oh-My-Zsh folder
export ZSH=~/.config/omz
export ZSH_THEME="powerlevel10k/powerlevel10k"

# Disable OMZ autoupdate
DISABLE_AUTO_UPDATE="true"
DISABLE_MAGIC_FUNCTIONS="true"
DISABLE_COMPFIX="true"

ZSH_AUTOSUGGEST_USE_ASYNC=1

# # GTK Theme
# export GTK_THEME="catppuccin-mocha-teal-standard+default"

export EDITOR="nvim"

# XDG Dirs
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_DATA_HOME="$HOME/.local/share"

# export XDG_CURRENT_DESKTOP=SWAY

# Enable wayland in Firefox
export MOZ_ENABLE_WAYLAND=1

# SSH auth sock for unlocking ssh keys only when keepassxc db is unlocked
export SSH_AUTH_SOCK="$XDG_RUNTIME_DIR/ssh-agent.socket"

# Fix Java applications
export _JAVA_AWT_WM_NONREPARENTING=1

# Set Qt to use the wayland backend
export QT_QPA_PLATFORM=wayland

# Golang
export GOPATH="$HOME/dev/go"
export GOBIN="$GOPATH/bin"

# Add paths to PATH
path+=(
	"$GOBIN"
	"/usr/share/bcc/tools"
	"$HOME/.local/share/JetBrains/Toolbox/scripts"
	"$HOME/.krew/bin:$PATH"
)
export PATH
