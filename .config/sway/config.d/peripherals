# vim: set ft=i3config

input * {
  drag_lock disabled
}

### Keyboard
input type:keyboard {
  xkb_layout "eu"
  xkb_options "caps:escape_shifted_capslock"
  xkb_numlock enable
}

### Mouse
input "1133:16493:Logitech_M705" {
	accel_profile adaptive
	pointer_accel 0
}

### Touchpad
input "2:14:ETPS/2_Elantech_Touchpad" {
    dwt enabled
    tap enabled
    natural_scroll enabled
    middle_emulation enabled
    accel_profile adaptive
    pointer_accel -0.2
}
